{
  "name": "shopping-list",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve public",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shopping \"node --test tests/rules/firestore.rules.test.js\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-shopping \"playwright test\"",
    "test:emulators": "firebase emulators:exec --only auth,firestore --project demo-shopping \"node --test tests/rules/firestore.rules.test.js && playwright test\"",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test": "npm run test:unit && npm run test:emulators"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "firebase": "13.1.0",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
